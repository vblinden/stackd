{
    "name": "vblinden/stackd",
    "description": "Local database and service manager for macOS — MySQL, MariaDB, PostgreSQL, Valkey, Mailpit, Meilisearch, and MinIO for Laravel development",
    "keywords": [
        "cli",
        "development",
        "laravel",
        "macos",
        "mailpit",
        "mariadb",
        "meilisearch",
        "minio",
        "mysql",
        "phar",
        "postgresql",
        "redis",
        "valet",
        "valkey"
    ],
    "homepage": "https://github.com/vblinden/stackd",
    "support": {
        "issues": "https://github.com/vblinden/stackd/issues",
        "source": "https://github.com/vblinden/stackd"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "vblinden",
            "homepage": "https://github.com/vblinden"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "laravel-zero/framework": "^12.0.2",
        "laravel/pint": "^1.25.1",
        "laravel/prompts": "^0.3.21",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/termwind": "^2.4",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "suggest": {
        "ext-pcntl": "Needed for animated spinners in Laravel Prompts"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "bin/stackd"
    ]
}
